# SMIB build-time configuration. Copy to .env and fill in; .env is gitignored.
#
# Everything here is a FACTORY DEFAULT, compiled into the firmware so a freshly
# flashed board joins the network without anyone typing on the touchscreen.
# Once staff save from the admin panel the values live in NVS and these are
# ignored. The passcode is the exception: it is always the compiled-in one.
#
# Changing this file re-runs CMake, so a rebuild picks it up.

# Opens the admin panel when the cabinet door is open. Digits only, 4 or more.
# There is no way to change this from the terminal — it is deliberately a
# build-time secret, so a stolen terminal cannot be re-pointed at another CMS.
SMIB_ADMIN_PASSCODE=4271

# Wi-Fi the terminal joins on boot. Leave blank to have staff set it up from
# the admin panel instead.
SMIB_WIFI_SSID=club-ap
SMIB_WIFI_PASS=change-me

# Where the CMS listens. Dotted IP or hostname; the port must be 1-65535.
# tools/host_sim/cms_tcp_server.py defaults to 9020.
SMIB_CMS_HOST=192.168.1.50
SMIB_CMS_PORT=9020
